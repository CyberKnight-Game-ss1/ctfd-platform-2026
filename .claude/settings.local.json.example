{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Copy file này thành .claude/settings.local.json rồi điền giá trị cá nhân. File .local.json KHÔNG commit (đã ghi trong .gitignore).",
  "env": {
    "AWS_PROFILE": "default"
  },
  "permissions": {
    "allow": [
      "Bash(aws configure list)"
    ],
    "deny": []
  },
  "outputStyle": "default"
}
