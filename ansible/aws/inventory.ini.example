# Inventory Template cho AWS — CHẾ ĐỘ SSM (khuyến nghị, dùng cho hạ tầng hiện tại)
# Sinh tự động: pwsh -File .claude/scripts/gen-inventory.ps1
#
# Hạ tầng này KHÔNG tạo aws_key_pair và KHÔNG mở port 22 → không SSH bằng key được.
# Ansible kết nối qua plugin `amazon.aws.aws_ssm`, với ansible_host = INSTANCE ID.
# Lấy instance ID: terraform -chdir=terraform/aws output -raw vm1_instance_id
#
# Yêu cầu control node: collection amazon.aws + boto3 + binary session-manager-plugin
# (chạy trên WSL Ubuntu; Windows không chạy được ansible-core do thiếu module fcntl).

[vm1_web]
ctf-vm1-web ansible_host=<VM1_INSTANCE_ID>

[vm2_challenge]
ctf-vm2-challenge ansible_host=<VM2_INSTANCE_ID>

[all:vars]
ansible_connection=amazon.aws.aws_ssm
ansible_aws_ssm_region=ap-southeast-1
ansible_aws_ssm_bucket_name=<S3_BUCKET_NAME>
ansible_aws_ssm_timeout=120
ansible_python_interpreter=/usr/bin/python3
aws_region=ap-southeast-1
